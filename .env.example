# PostgreSQL connection string used only by the server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Clerk — https://dashboard.clerk.com
# The publishable key is public; the secret key is server-only and also signs
# short-lived album access and anonymous guest-session cookies.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ImageKit — https://imagekit.io/dashboard
# Uploads are proxied by the server; only the URL endpoint and public key may
# be exposed to the browser. The private API key is server-only.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PRIVATE_KEY=

# Long random secret configured in the hosting platform and scheduler.
# Authorizes the scheduled media-cleanup worker.
CRON_SECRET=
