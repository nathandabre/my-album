// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AlbumVisibility {
  PRIVATE
  UNLISTED
  PASSWORD
}

enum AlbumAssetType {
  IMAGE
  VIDEO
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums Album[]
}

model Album {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  coverPhotoId String? @unique
  coverPhoto   Photo?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  shareSlug     String          @unique
  visibility    AlbumVisibility @default(UNLISTED)
  passwordHash  String?
  allowDownload Boolean         @default(false)
  expiresAt     DateTime?

  photos Photo[]      @relation("AlbumPhotos")
  pages  AlbumPage[]
  assets AlbumAsset[]
  passwordAttempts AlbumPasswordAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model AlbumPage {
  id      String @id @default(cuid())
  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  title       String?
  sortOrder   Int       @default(0)
  width       Int       @default(1200)
  height      Int       @default(1600)
  designJson  Json
  publishedAt DateTime?

  renderedAsset AlbumAsset? @relation("PageRender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId, sortOrder])
}

model AlbumAsset {
  id      String @id @default(cuid())
  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  imagekitFileId String         @unique
  filePath       String
  fileName       String
  mimeType       String
  type           AlbumAssetType
  isPrivate      Boolean          @default(false)
  width          Int              @default(0)
  height         Int            @default(0)
  sizeBytes      Int

  renderedPageId String?    @unique
  renderedPage   AlbumPage? @relation("PageRender", fields: [renderedPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([albumId, createdAt])
}

model Photo {
  id      String @id @default(cuid())
  albumId String
  album   Album  @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)

  imagekitFileId String  @unique
  filePath       String
  caption        String?
  width          Int
  height         Int
  sizeBytes      Int
  mimeType       String
  isPrivate      Boolean @default(false)

  sortOrder Int @default(0)

  coverFor  Album?          @relation("AlbumCover")
  favorites AlbumFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId, sortOrder])
}

model AlbumFavorite {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  guestId   String
  guestName String?
  createdAt DateTime @default(now())

  @@unique([photoId, guestId])
  @@index([photoId])
  @@index([guestId, photoId])
}

model AlbumPasswordAttempt {
  id      String @id @default(cuid())
  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  clientKey      String
  failedAttempts Int       @default(0)
  windowStartedAt DateTime @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([albumId, clientKey])
  @@index([lockedUntil])
}
