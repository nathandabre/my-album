// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AlbumVisibility {
  PRIVATE
  UNLISTED
  PASSWORD
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums Album[]
}

model Album {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  coverPhotoId String? @unique
  coverPhoto   Photo?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  shareSlug     String          @unique
  visibility    AlbumVisibility @default(UNLISTED)
  passwordHash  String?
  allowDownload Boolean         @default(false)
  expiresAt     DateTime?

  photos Photo[] @relation("AlbumPhotos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model Photo {
  id      String @id @default(cuid())
  albumId String
  album   Album  @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)

  imagekitFileId String  @unique
  filePath       String
  caption        String?
  width          Int
  height         Int
  sizeBytes      Int
  mimeType       String

  sortOrder Int @default(0)

  coverFor  Album?          @relation("AlbumCover")
  favorites AlbumFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId, sortOrder])
}

model AlbumFavorite {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  guestId   String
  guestName String?
  createdAt DateTime @default(now())

  @@unique([photoId, guestId])
  @@index([photoId])
}
